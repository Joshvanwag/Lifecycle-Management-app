# Supabase — copy to .env.local and fill in values from your Supabase project dashboard.
# Never commit .env.local or expose secret keys to the browser.

# @supabase/server (and server-side supabase-js)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Next.js browser/SSR clients (@supabase/ssr) — browser-safe only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy alias for admin/seed operations. Prefer SUPABASE_SECRET_KEY.
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
